{
  "tasks": {
    "start": "deno run --allow-net --allow-read=. --allow-run=ffmpeg,v4l2-ctl --allow-env=HOST,PORT server.js",
    "dev": "deno run --watch=server.js,server,shared,public --allow-net --allow-read=. --allow-run=ffmpeg,v4l2-ctl --allow-env=HOST,PORT server.js",
    "test": "deno test --allow-read --allow-run=ffmpeg tests/",
    "check": "deno check server.js shared/*.js"
  },
  "fmt": { "lineWidth": 100, "exclude": ["docs/", "node_modules/"] }
}
